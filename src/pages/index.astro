  @keyframes floatUp {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-6px); }
  }

  /* Respetar preferencia de movimiento reducido */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* ---------------------------------------------------------------
     RESET Y BASE
  --------------------------------------------------------------- */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    font-size: 16px;
  }

  main section[id]:not(#inicio) {
    scroll-margin-top: 110px;
  }

  body {
    font-family: var(--font-body);
    background-color: var(--color-bg);
    color: var(--color-text-primary);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  ul, ol {
    list-style: none;
  }

  /* Focus visible global — accesibilidad teclado */
  :focus-visible {
    outline: 3px solid var(--color-brand);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  /* Quitar outline en mouse, mantener en teclado */
  :focus:not(:focus-visible) {
    outline: none;
  }

  /* Skip-to-content: solo visible al recibir foco con teclado */
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-sm);
    padding: 8px 18px;
    background: var(--color-brand);
    color: #fff;
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9375rem;
    z-index: 9999;
    text-decoration: none;
    transition: top var(--transition-fast);
  }

  .skip-link:focus {
    top: var(--space-sm);
    outline: 3px solid #fff;
    outline-offset: 2px;
  }

  /* ---------------------------------------------------------------
     LAYOUT: CONTAINER
  --------------------------------------------------------------- */
  .container {
    max-width: 1140px;
    margin-inline: auto;
    padding-inline: var(--space-sm);
  }

  /* ---------------------------------------------------------------
     TIPOGRAFÍA
  --------------------------------------------------------------- */
  .section-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.2;
  }

  .section-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    max-width: 60ch;
    margin-inline: auto;
    line-height: 1.7;
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    align-items: center;
  }

  /* ---------------------------------------------------------------
     BOTONES
  --------------------------------------------------------------- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    border: 2px solid transparent;
    transition: background-color var(--transition-normal),
                transform var(--transition-fast),
                box-shadow var(--transition-normal);
    text-decoration: none;
    white-space: nowrap;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn:active {
    transform: translateY(0);
  }

  .btn-primary {
    background-color: var(--color-brand);
    color: #fff;
    border-color: var(--color-brand);
    padding: 10px 24px;
  }

  .btn-primary:hover {
    background-color: var(--color-brand-mid);
    border-color: var(--color-brand-mid);
    box-shadow: 0 4px 16px rgba(46, 125, 50, 0.3);
  }

  .btn-sm {
    font-size: 0.875rem;
    padding: 8px 18px;
  }

  .btn-lg {
    font-size: 1.0625rem;
    padding: 14px 32px;
  }

  .btn-white {
    background-color: #fff;
    color: var(--color-brand);
    border-color: #fff;
    padding: 14px 32px;
  }

  .btn-white:hover {
    background-color: var(--color-brand-surface);
    border-color: var(--color-brand-surface);
    box-shadow: 0 4px 16px rgba(255, 255, 255, 0.3);
  }

  .btn-outline-white {
    background-color: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.6);
    padding: 14px 32px;
  }

  .btn-outline-white:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: #fff;
  }

  .btn-link {
    color: var(--color-brand);
    font-weight: 500;
    font-size: 0.9375rem;
    transition: opacity var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .btn-link:hover {
    opacity: 0.7;
  }

  /* ---------------------------------------------------------------
     BADGES
  --------------------------------------------------------------- */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .badge-brand {
    background-color: var(--color-brand-surface);
    color: var(--color-brand);
    border: 1px solid var(--color-brand-light);
  }

  /* ---------------------------------------------------------------
     HEADER
  --------------------------------------------------------------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(250, 250, 250, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition-normal),
                box-shadow var(--transition-normal);
  }

  .site-header.header-scrolled {
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-header);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: 68px;
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text-primary);
    flex-shrink: 0;
    transition: opacity var(--transition-fast);
  }

  .logo:hover {
    opacity: 0.8;
  }

  .logo-icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }

  .logo-text {
    color: var(--color-brand);
  }

  /* Nav links desktop */
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-brand);
    border-radius: 2px;
    transition: width var(--transition-normal);
  }

  .nav-link:hover {
    color: var(--color-brand);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast);
  }

  .hamburger:hover {
    background-color: var(--color-brand-surface);
  }

  .hamburger-line {
    display: block;
    width: 22px;
    height: 2px;
    background-color: var(--color-text-primary);
    border-radius: 2px;
    transition: transform var(--transition-normal), opacity var(--transition-fast);
  }

  .hamburger.is-open .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .hamburger.is-open .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .hamburger.is-open .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Menú móvil */
  /* hidden attribute oculta el elemento; cuando JS lo abre, quita hidden y
     el CSS flex solo aplica en móvil */
  .mobile-menu[hidden] {
    display: none !important;
  }

  .mobile-menu {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-sm);
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  /* En desktop siempre oculto, independientemente del estado JS */
  @media (min-width: 901px) {
    .mobile-menu {
      display: none !important;
    }
  }

  .mobile-link {
    padding: 12px var(--space-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .mobile-link:hover {
    background-color: var(--color-brand-surface);
    color: var(--color-brand);
  }

  .mobile-cta {
    margin-top: var(--space-xs);
    text-align: center;
  }

  /* ---------------------------------------------------------------
     SECCIONES — LAYOUT BASE
  --------------------------------------------------------------- */
  .section {
    padding-block: var(--space-xl);
  }

  .section-white {
    background-color: var(--color-surface);
  }

  .section-light {
    background-color: var(--color-light);
  }

  .section-brand-surface {
    background-color: var(--color-brand-surface);
  }

  /* ---------------------------------------------------------------
     HERO
  --------------------------------------------------------------- */
  .hero {
    /* Gradiente muy sutil de blanco a verde pálido */
    background: linear-gradient(160deg, #ffffff 0%, #f4faf4 100%);
    padding-block: var(--space-xl) calc(var(--space-2xl) + 30px);
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  /* Animación de entrada del texto hero */
  .hero-animate {
    animation: fadeInUp var(--anim-duration) ease both;
  }

  .hero-phone-animate {
    animation: fadeIn var(--anim-duration) 200ms ease both;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-text-primary);
  }

  .text-brand {
    color: var(--color-brand);
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 48ch;
  }

  /* Chips de características en el hero */
  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    background: var(--color-brand-surface);
    border: 1px solid var(--color-brand-light);
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-brand);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-top: var(--space-xs);
  }

  /* Hero visual (columna derecha) */
  .hero-visual {
    display: flex;
    justify-content: center;
    position: relative;
    /* Flota suavemente — desactivado con prefers-reduced-motion */
    animation: floatUp 4s ease-in-out infinite;
  }

  /* Mockup de teléfono mejorado */
  .phone-mockup {
    width: 265px;
    background: #fff;
    border-radius: 44px;
    box-shadow:
      0 0 0 8px #1A2E1C,       /* bisel oscuro */
      0 0 0 10px #2e7d32,      /* aro verde fino */
      0 32px 80px rgba(0, 0, 0, 0.28),
      0 8px 24px rgba(46, 125, 50, 0.15);
    overflow: hidden;
    position: relative;
    z-index: 2;
  }

  /* Notch superior del teléfono */
  .phone-notch {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 22px;
    background: #1A2E1C;
    border-radius: 0 0 16px 16px;
    z-index: 10;
  }

  .phone-screen {
    background: #f0f4f0;
    min-height: 500px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .phone-statusbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 26px 16px 4px; /* espacio para el notch */
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    background: #fff;
  }

  .statusbar-right {
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--color-text-secondary);
  }

  .phone-appbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: #fff;
    border-bottom: 1px solid var(--color-border);
  }

  .phone-appbar-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-brand);
  }

  /* Área de escaneo QR simulada */
  .phone-scan-area {
    margin: 12px 16px 8px;
    aspect-ratio: 1;
    background: rgba(255,255,255,0.6);
    border-radius: var(--radius-md);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* Línea de escaneo animada */
  .scan-line {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 10%;
    height: 2px;
    background: linear-gradient(90deg, transparent, #2E7D32, transparent);
    border-radius: 2px;
    animation: scanLine 2s ease-in-out infinite;
    box-shadow: 0 0 8px rgba(46,125,50,0.5);
  }

  /* Esquinas del marco de escaneo */
  .scan-corner {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: var(--color-brand);
    border-style: solid;
    border-width: 0;
  }
  .scan-corner-tl { top: 6px;    left: 6px;    border-top-width: 2.5px; border-left-width: 2.5px;   border-radius: 3px 0 0 0; }
  .scan-corner-tr { top: 6px;    right: 6px;   border-top-width: 2.5px; border-right-width: 2.5px;  border-radius: 0 3px 0 0; }
  .scan-corner-bl { bottom: 6px; left: 6px;    border-bottom-width: 2.5px; border-left-width: 2.5px; border-radius: 0 0 0 3px; }
  .scan-corner-br { bottom: 6px; right: 6px;   border-bottom-width: 2.5px; border-right-width: 2.5px; border-radius: 0 0 3px 0; }

  .scan-qr-icon {
    width: 48px;
    height: 48px;
    opacity: 0.5;
  }

  /* Tarjeta resultado dentro del mockup */
  .result-card {
    margin: 8px 12px 12px;
    background: #fff;
    border-radius: var(--radius-lg);
    padding: 14px;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .result-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 7px;
  }

  .result-label {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .result-status {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    border-radius: var(--radius-md);
  }

  .result-status.safe {
    background-color: var(--color-safe-bg);
    border: 1px solid rgba(76,175,80,0.2);
  }

  .result-icon {
    font-size: 1.125rem;
  }

  .result-level {
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--color-brand);
    letter-spacing: 0.06em;
  }

  .result-summary {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .result-url {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 9px;
    background: var(--color-light);
    border-radius: var(--radius-sm);
  }

  .result-url-icon {
    font-size: 0.8125rem;
  }

  .result-url-text {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .result-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .result-analysis-status {
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--color-safe);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .result-time {
    font-size: 0.625rem;
    color: var(--color-text-muted);
  }

  /* Glow de fondo hero */
  .hero-glow {
    position: absolute;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(76, 175, 80, 0.18) 0%, transparent 68%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    pointer-events: none;
  }

  /* Badge flotante sobre el mockup */
  .hero-float-badge {
    position: absolute;
    bottom: 24px;
    right: -16px;
    background: #fff;
    border-radius: var(--radius-pill);
    padding: 8px 14px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-brand);
    box-shadow: 0 4px 20px rgba(46,125,50,0.18);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 4;
    white-space: nowrap;
  }

  .float-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-safe);
    animation: pulse 1.5s ease-in-out infinite;
    flex-shrink: 0;
  }

  /* Patrón QR de fondo */
  .hero-bg-pattern {
    position: absolute;
    top: -20px;
    right: -20px;
    width: 320px;
    height: 320px;
    pointer-events: none;
    opacity: 0.04;
  }

  .hero-bg-pattern svg {
    width: 100%;
    height: 100%;
  }

  /* Ola decorativa inferior del hero */
  .hero-wave {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    line-height: 0;
    pointer-events: none;
    z-index: 1;
  }

  .hero-wave svg {
    width: 100%;
    height: 60px;
    display: block;
  }

  /* ---------------------------------------------------------------
     CARDS GRID
  --------------------------------------------------------------- */
  .cards-grid {
    display: grid;
    gap: var(--space-md);
  }

  .cards-grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  /* Card base */
  .card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-border);
    transition: transform var(--transition-normal),
                box-shadow var(--transition-normal),
                border-color var(--transition-normal);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-brand-light);
  }

  /* Focus visible en cards que sean links */
  .card:focus-visible {
    outline: 3px solid var(--color-brand);
    outline-offset: 2px;
  }

  /* Icono en cards */
  .card-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background-color: var(--color-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-xs);
    flex-shrink: 0;
  }

  .card-icon-wrap svg {
    width: 24px;
    height: 24px;
    color: var(--color-text-secondary);
  }

  .card-icon-brand {
    background-color: var(--color-brand-surface);
  }

  .card-icon-brand svg {
    color: var(--color-brand);
  }

  .card-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .card-text {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Card problem: icono gris */
  .card-problem .card-icon-wrap svg {
    color: var(--color-text-muted);
  }

  /* ---------------------------------------------------------------
     SECCIÓN QUISHING
  --------------------------------------------------------------- */
  .quishing-block {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-lg);
    border-left: 4px solid var(--color-suspicious);
    box-shadow: var(--shadow-card);
  }

  .quishing-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-xs);
  }

  .quishing-text {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  /* ---------------------------------------------------------------
     DISCLAIMER / NOTAS
  --------------------------------------------------------------- */
  .disclaimer-text {
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    max-width: 60ch;
    margin-inline: auto;
    margin-top: var(--space-lg);
    line-height: 1.6;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid var(--color-border);
  }

  .note-text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top: var(--space-lg);
    padding: var(--space-sm) var(--space-md);
    background: rgba(255, 255, 255, 0.6);
    border-radius: var(--radius-md);
