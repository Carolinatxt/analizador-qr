---
// QR Scanner Security — Landing Page
// Proyecto de Trabajo de Fin de Grado
// Fase 4: Refinamiento visual y accesibilidad
const base = import.meta.env.BASE_URL;
const withBase = (path) => `${base.replace(/\/?$/, '/')}${path.replace(/^\//, '')}`;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>QR Scanner Security — Comprueba un código QR antes de abrirlo</title>
    <meta
      name="description"
      content="QR Scanner Security analiza el enlace de un código QR con fuentes externas de reputación y te muestra si parece seguro, sospechoso o peligroso, para que puedas decidir con más información."
    />
    <meta name="robots" content="index, follow" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />

    <!-- Open Graph básico -->
    <meta property="og:title" content="QR Scanner Security — Comprueba un código QR antes de abrirlo" />
    <meta
      property="og:description"
      content="Analiza el enlace de un QR con fuentes externas de reputación antes de decidir si abrirlo."
    />
    <meta property="og:type" content="website" />
    <!-- og:image: sustituir por una captura real de la landing cuando esté publicada -->
    <meta property="og:image" content={withBase('/favicon.svg')} />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>

    <!-- Skip-to-content: accesibilidad para usuarios de teclado/lector de pantalla -->
    <a href="#inicio" class="skip-link">Saltar al contenido principal</a>

    <!-- ============================================================
         HEADER — Navegación principal sticky
    ============================================================ -->
    <header class="site-header" id="site-header">
      <div class="container header-inner">

        <!-- Logo -->
        <a href="#inicio" class="logo" aria-label="QR Scanner Security - Ir al inicio">
          <img
            class="logo-icon"
            src={withBase('/images/logo-analizador-qr.png')}
            alt="Logo de QR Scanner Security"
            loading="eager"
            decoding="async"
          />
          <span class="logo-text">QR Scanner Security</span>
        </a>

        <!-- Navegación desktop -->
        <nav class="nav-links" aria-label="Navegación principal">
          <a href="#problema" class="nav-link">El problema</a>
          <a href="#como-funciona" class="nav-link">Cómo funciona</a>
          <a href="#funcionalidades" class="nav-link">Funcionalidades</a>
          <a href="#capturas" class="nav-link">Capturas</a>
          <a href="#seguridad" class="nav-link">Seguridad</a>
        </nav>

        <!-- CTA header -->
        <a href="#como-funciona" class="btn btn-primary btn-sm" id="header-cta">
          Conocer el proyecto
        </a>

        <!-- Hamburger móvil -->
        <button
          class="hamburger"
          id="hamburger-btn"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>

      <!-- Menú móvil -->
      <nav class="mobile-menu" id="mobile-menu" aria-label="Menú móvil" hidden>
        <a href="#problema" class="mobile-link">El problema</a>
        <a href="#como-funciona" class="mobile-link">Cómo funciona</a>
        <a href="#funcionalidades" class="mobile-link">Funcionalidades</a>
        <a href="#capturas" class="mobile-link">Capturas</a>
        <a href="#seguridad" class="mobile-link">Seguridad</a>
        <a href="#como-funciona" class="btn btn-primary mobile-cta">Conocer el proyecto</a>
      </nav>
    </header>


    <main>

      <!-- ============================================================
           SECCIÓN: HERO — #inicio
      ============================================================ -->
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="container hero-inner">

          <!-- Columna izquierda: texto -->
          <div class="hero-text hero-animate">

            <h1 id="hero-title" class="hero-title">
              ¿Es seguro este QR?<br />
              <span class="text-brand">Compruébalo antes de abrirlo.</span>
            </h1>

            <p class="hero-subtitle">
              QR Scanner Security analiza el enlace que contiene un código QR y te muestra
              si parece seguro, sospechoso o peligroso, para que puedas decidir
              con más información.
            </p>

            <!-- Chips de características rápidas -->
            <div class="hero-chips" aria-label="Características clave">
              <span class="hero-chip">Semáforo de riesgo</span>
              <span class="hero-chip">Sin abrir el enlace</span>
              <span class="hero-chip">Análisis externo</span>
            </div>

            <div class="hero-actions">
              <a href="#como-funciona" class="btn btn-primary btn-lg" id="hero-cta-primary">
                Ver cómo funciona
              </a>
              <a href="#capturas" class="btn-link" id="hero-cta-secondary">
                Ver capturas de la app →
              </a>
            </div>
          </div>

          <!-- Columna derecha: mockup de teléfono (CSS puro) -->
          <div class="hero-visual" aria-hidden="true">

            <!-- Círculo de fondo decorativo -->
            <div class="hero-glow"></div>

            <div class="phone-mockup hero-phone-animate">
              <!-- Notch superior decorativo -->
              <div class="phone-notch"></div>

              <div class="phone-screen">
                <!-- Barra de estado simulada -->
                <div class="phone-statusbar">
                  <span>19:33</span>
                  <span class="statusbar-right">
                    <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
                      <rect x="0" y="3" width="2" height="7" rx="1" fill="currentColor" opacity="0.4"/>
                      <rect x="3" y="2" width="2" height="8" rx="1" fill="currentColor" opacity="0.6"/>
                      <rect x="6" y="1" width="2" height="9" rx="1" fill="currentColor" opacity="0.8"/>
                      <rect x="9" y="0" width="2" height="10" rx="1" fill="currentColor"/>
                    </svg>
                    100%
                  </span>
                </div>

                <!-- App bar -->
                <div class="phone-appbar">
                  <svg width="18" height="18" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                    <path d="M16 3L5 7.5V15c0 6.075 4.667 11.742 11 13.338C22.333 26.742 27 21.075 27 15V7.5L16 3Z" fill="#2E7D32"/>
                    <path d="M11 16l3.5 3.5L21 12" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span class="phone-appbar-title">QR Scanner</span>
                </div>

                <!-- Área de escaneo simulada -->
                <div class="phone-scan-area">
                  <div class="scan-corner scan-corner-tl"></div>
                  <div class="scan-corner scan-corner-tr"></div>
                  <div class="scan-corner scan-corner-bl"></div>
                  <div class="scan-corner scan-corner-br"></div>
                  <!-- Línea de escaneo animada -->
                  <div class="scan-line" aria-hidden="true"></div>
                  <!-- QR icon centro -->
                  <svg class="scan-qr-icon" viewBox="0 0 24 24" fill="none" stroke="#A5D6A7" stroke-width="1" aria-hidden="true">
                    <rect x="3" y="3" width="7" height="7"/>
                    <rect x="14" y="3" width="7" height="7"/>
                    <rect x="3" y="14" width="7" height="7"/>
                    <rect x="5" y="5" width="3" height="3" fill="#A5D6A7" stroke="none"/>
                    <rect x="16" y="5" width="3" height="3" fill="#A5D6A7" stroke="none"/>
                    <rect x="5" y="16" width="3" height="3" fill="#A5D6A7" stroke="none"/>
                  </svg>
                </div>

                <!-- Tarjeta resultado -->
                <div class="result-card">
                  <div class="result-header">
                    <span class="result-label">Resultado del análisis</span>
                  </div>

                  <div class="result-status safe">
                    <span class="result-icon">✅</span>
                    <span class="result-level">SEGURO</span>
                  </div>

                  <p class="result-summary">
                    No se detectaron señales de riesgo conocidas en este enlace.
                  </p>

                  <div class="result-url">
                    <span class="result-url-icon">🔗</span>
                    <span class="result-url-text">ejemplo.com/pagina</span>
                  </div>

                  <div class="result-meta">
                    <span class="result-analysis-status">Análisis completo</span>
                    <span class="result-time">Hace un momento</span>
                  </div>
                </div>

              </div>
            </div>

            <!-- Badge flotante: proveedores -->
            <div class="hero-float-badge" aria-hidden="true">
              <span class="float-badge-dot"></span>
              Análisis en curso…
            </div>

          </div>

        </div>

        <!-- Decoración: patrón QR de fondo (esquina superior derecha) -->
        <div class="hero-bg-pattern" aria-hidden="true">
          <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <rect x="10" y="10" width="60" height="60" fill="none" stroke="#2E7D32" stroke-width="8"/>
            <rect x="20" y="20" width="40" height="40" fill="#2E7D32"/>
            <rect x="130" y="10" width="60" height="60" fill="none" stroke="#2E7D32" stroke-width="8"/>
            <rect x="140" y="20" width="40" height="40" fill="#2E7D32"/>
            <rect x="10" y="130" width="60" height="60" fill="none" stroke="#2E7D32" stroke-width="8"/>
            <rect x="20" y="140" width="40" height="40" fill="#2E7D32"/>
            <rect x="80" y="10" width="12" height="12" fill="#2E7D32"/>
            <rect x="96" y="10" width="12" height="12" fill="#2E7D32"/>
            <rect x="80" y="26" width="12" height="12" fill="#2E7D32"/>
            <rect x="96" y="26" width="12" height="12" fill="#2E7D32"/>
            <rect x="130" y="130" width="20" height="20" fill="#2E7D32"/>
            <rect x="155" y="155" width="20" height="20" fill="#2E7D32"/>
            <rect x="130" y="155" width="20" height="20" fill="#2E7D32"/>
            <rect x="155" y="130" width="20" height="20" fill="#2E7D32"/>
          </svg>
        </div>

        <!-- Ola decorativa inferior del hero -->
        <div class="hero-wave" aria-hidden="true">
          <svg viewBox="0 0 1440 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,30 C360,60 1080,0 1440,30 L1440,60 L0,60 Z" fill="#F5F7F5"/>
          </svg>
        </div>
      </section>


      <!-- ============================================================
           SECCIÓN: EL PROBLEMA — #problema
      ============================================================ -->
      <section class="section section-light" id="problema" aria-labelledby="problema-title">
        <div class="container">

          <div class="section-header">
            <h2 id="problema-title" class="section-title">
              Los códigos QR pueden ocultar sorpresas
            </h2>
            <p class="section-subtitle">
              Los QR son prácticos y están en todas partes: restaurantes, carteles,
              correos, paquetes. Pero a diferencia de un enlace visible, no puedes
              saber a dónde te llevan antes de escanearlos.
            </p>
          </div>

          <!-- Subtítulo quishing -->
          <div class="quishing-block">
            <h3 class="quishing-title">¿Qué es el quishing?</h3>
            <p class="quishing-text">
              El quishing es una técnica de engaño que usa códigos QR para dirigir
              a páginas falsas que imitan servicios legítimos, intentando robar datos
              o instalar software malicioso. Estos ataques aprovechan la confianza
              habitual en los códigos QR y pueden pasar desapercibidos para usuarios
              no técnicos.
            </p>
          </div>

          <!-- 3 cards de contexto -->
          <div class="cards-grid cards-grid-3">

            <article class="card card-problem" aria-label="Sin visibilidad previa">
              <div class="card-icon-wrap">
                <!-- Icono: ojo -->
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                  <circle cx="12" cy="12" r="3"/>
                  <line x1="4" y1="4" x2="20" y2="20" stroke-width="2.5"/>
                </svg>
              </div>
              <h3 class="card-title">Sin visibilidad previa</h3>
              <p class="card-text">
                Un QR es opaco por diseño. No puedes leer la URL antes de escanearlo.
              </p>
            </article>

            <article class="card card-problem" aria-label="Destino poco evidente">
              <div class="card-icon-wrap">
                <!-- Icono: enlace con interrogación -->
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                  <line x1="12" y1="16" x2="12" y2="18"/>
                  <circle cx="12" cy="21" r="0.5" fill="currentColor"/>
                </svg>
              </div>
              <h3 class="card-title">Destino poco evidente</h3>
              <p class="card-text">
                Un enlace dentro de un QR puede dirigir a una página que el usuario
                no esperaba visitar.
              </p>
            </article>

            <article class="card card-problem" aria-label="Cualquiera puede ser objetivo">
              <div class="card-icon-wrap">
                <!-- Icono: persona -->
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
              </div>
              <h3 class="card-title">Cualquiera puede ser objetivo</h3>
              <p class="card-text">
                Los ataques basados en QR no discriminan: usuarios cotidianos son
                el blanco más frecuente.
              </p>
            </article>

          </div>
        </div>
      </section>


      <!-- ============================================================
           SECCIÓN: PROPUESTA DE VALOR Y BENEFICIOS — #propuesta
      ============================================================ -->
      <section class="section section-brand-surface" id="propuesta" aria-labelledby="propuesta-title">
        <div class="container">

          <div class="section-header">
            <h2 id="propuesta-title" class="section-title">
              Una capa de análisis antes de decidir
            </h2>
            <p class="section-subtitle">
              QR Scanner Security no sustituye tu criterio ni garantiza seguridad absoluta.
              Pero te da información antes de abrir un enlace desconocido: señales de
              riesgo detectadas por fuentes externas especializadas, presentadas de
              forma clara y comprensible.
            </p>
          </div>

          <!-- 3 beneficios -->
          <div class="cards-grid cards-grid-3">

            <article class="card card-benefit" aria-label="Más información, mejor decisión">
              <div class="card-icon-wrap card-icon-brand">
                <!-- Icono: cerebro/mente -->
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"/>
                  <path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"/>
                </svg>
              </div>
              <h3 class="card-title">Más información, mejor decisión</h3>
              <p class="card-text">
                Conoces el nivel de riesgo antes de visitar el enlace. Tú decides
                si continuar.
              </p>
            </article>

            <article class="card card-benefit" aria-label="Resultado claro y directo">
              <div class="card-icon-wrap card-icon-brand">
                <!-- Icono: semáforo -->
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="6" y="2" width="12" height="20" rx="5"/>
                  <circle cx="12" cy="7" r="2" fill="#4CAF50" stroke="none"/>
                  <circle cx="12" cy="13" r="2" fill="#FF8F00" stroke="none"/>
                  <circle cx="12" cy="19" r="2" fill="#D32F2F" stroke="none"/>
                </svg>
              </div>
              <h3 class="card-title">Resultado claro y directo</h3>
              <p class="card-text">
                Sin tecnicismos. Un semáforo visual te indica si el enlace parece
                seguro, sospechoso o peligroso.
              </p>
            </article>

            <article class="card card-benefit" aria-label="Enfoque preventivo por defecto">
              <div class="card-icon-wrap card-icon-brand">
                <!-- Icono: escudo check -->
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <polyline points="9 12 11 14 15 10"/>
                </svg>
              </div>
              <h3 class="card-title">Enfoque preventivo por defecto</h3>
              <p class="card-text">
                Si el análisis no puede ser completo, el sistema adopta una postura
                conservadora. Ante la duda, alerta.
              </p>
            </article>

          </div>

          <!-- Nota disclaimer -->
          <p class="disclaimer-text">
            QR Scanner Security es un prototipo de validación técnica desarrollado como
            Trabajo de Fin de Grado. Su objetivo es demostrar la viabilidad del
            concepto, no ofrecer una solución de seguridad definitiva.
          </p>

        </div>
      </section>


      <!-- ============================================================
           SECCIÓN: CÓMO FUNCIONA — #como-funciona
      ============================================================ -->
      <section class="section section-white" id="como-funciona" aria-labelledby="como-funciona-title">
        <div class="container">

          <div class="section-header">
            <h2 id="como-funciona-title" class="section-title">
              Cómo funciona QR Scanner Security
            </h2>
            <p class="section-subtitle">Un proceso simple en cuatro pasos</p>
          </div>

          <!-- Flujo de 4 pasos -->
          <div class="steps-flow" role="list">

            <div class="step" role="listitem" aria-label="Paso 1: Escanea el QR">
              <div class="step-number" aria-hidden="true">01</div>
              <div class="step-icon-wrap" aria-hidden="true">
                <!-- Icono QR -->
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="7" height="7"/>
                  <rect x="14" y="3" width="7" height="7"/>
                  <rect x="3" y="14" width="7" height="7"/>
                  <rect x="5" y="5" width="3" height="3" fill="currentColor" stroke="none"/>
                  <rect x="16" y="5" width="3" height="3" fill="currentColor" stroke="none"/>
                  <rect x="5" y="16" width="3" height="3" fill="currentColor" stroke="none"/>
                  <line x1="14" y1="14" x2="14" y2="14" stroke-width="3"/>
                  <line x1="19" y1="14" x2="19" y2="14" stroke-width="3"/>
                  <line x1="14" y1="19" x2="14" y2="19" stroke-width="3"/>
                  <line x1="19" y1="19" x2="19" y2="19" stroke-width="3"/>
                </svg>
              </div>
              <h3 class="step-title">Escanea el QR</h3>
              <p class="step-text">
                Apunta con la cámara al código QR. La app lo detecta automáticamente
                usando el lector integrado.
              </p>
            </div>

            <div class="step-connector" aria-hidden="true"></div>

            <div class="step" role="listitem" aria-label="Paso 2: Se detecta la URL">
              <div class="step-number" aria-hidden="true">02</div>
              <div class="step-icon-wrap" aria-hidden="true">
                <!-- Icono enlace -->
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                </svg>
              </div>
              <h3 class="step-title">Se detecta la URL</h3>
              <p class="step-text">
                La app comprueba si el QR contiene una URL web válida. Si no la hay,
                te lo indica sin continuar.
              </p>
            </div>

            <div class="step-connector" aria-hidden="true"></div>

            <div class="step" role="listitem" aria-label="Paso 3: Se analiza el enlace">
              <div class="step-number" aria-hidden="true">03</div>
              <div class="step-icon-wrap" aria-hidden="true">
                <!-- Icono análisis/nube -->
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" y1="8" x2="12" y2="12"/>
                  <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
              </div>
              <h3 class="step-title">Se analiza el enlace</h3>
              <p class="step-text">
                La URL se envía al servidor, que la consulta en paralelo con proveedores
                externos de reputación: Google Web Risk e IPQualityScore.
              </p>
            </div>

            <div class="step-connector" aria-hidden="true"></div>

            <div class="step" role="listitem" aria-label="Paso 4: Ves el resultado">
              <div class="step-number" aria-hidden="true">04</div>
              <div class="step-icon-wrap" aria-hidden="true">
                <!-- Icono check / resultado -->
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                  <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
              </div>
              <h3 class="step-title">Ves el resultado</h3>
              <p class="step-text">
                En segundos recibes el nivel de riesgo detectado, junto con una breve
                explicación en lenguaje claro.
              </p>
            </div>

          </div>

          <!-- Nota de transparencia -->
          <p class="note-text">
            <span class="note-info-icon" aria-hidden="true">i</span> El análisis puede ser <strong>completo</strong>, <strong>parcial</strong>
            o <strong>no disponible</strong>, dependiendo de la respuesta de los
            proveedores externos. El resultado siempre indica el estado de la consulta.
          </p>

        </div>
      </section>


