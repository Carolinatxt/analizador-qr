  .btn-lg {
    font-size: 1.0625rem;
    padding: 14px 32px;
  }

  .btn-white {
    background-color: #fff;
    color: var(--color-brand);
    border-color: #fff;
    padding: 14px 32px;
  }

  .btn-white:hover {
    background-color: var(--color-brand-surface);
    border-color: var(--color-brand-surface);
    box-shadow: 0 4px 16px rgba(255, 255, 255, 0.3);
  }

  .btn-outline-white {
    background-color: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.6);
    padding: 14px 32px;
  }

  .btn-outline-white:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: #fff;
  }

  .btn-link {
    color: var(--color-brand);
    font-weight: 500;
    font-size: 0.9375rem;
    transition: opacity var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .btn-link:hover {
    opacity: 0.7;
  }

  /* ---------------------------------------------------------------
     BADGES
  --------------------------------------------------------------- */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .badge-brand {
    background-color: var(--color-brand-surface);
    color: var(--color-brand);
    border: 1px solid var(--color-brand-light);
  }

  /* ---------------------------------------------------------------
     HEADER
  --------------------------------------------------------------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(250, 250, 250, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition-normal),
                box-shadow var(--transition-normal);
  }

  .site-header.header-scrolled {
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-header);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: 68px;
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text-primary);
    flex-shrink: 0;
    transition: opacity var(--transition-fast);
  }

  .logo:hover {
    opacity: 0.8;
  }

  .logo-icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }

  .logo-text {
    color: var(--color-brand);
  }

  /* Nav links desktop */
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-brand);
    border-radius: 2px;
    transition: width var(--transition-normal);
  }

  .nav-link:hover {
    color: var(--color-brand);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast);
  }

  .hamburger:hover {
    background-color: var(--color-brand-surface);
  }

  .hamburger-line {
    display: block;
    width: 22px;
    height: 2px;
    background-color: var(--color-text-primary);
    border-radius: 2px;
    transition: transform var(--transition-normal), opacity var(--transition-fast);
  }

  .hamburger.is-open .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .hamburger.is-open .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .hamburger.is-open .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Menú móvil */
  /* hidden attribute oculta el elemento; cuando JS lo abre, quita hidden y
     el CSS flex solo aplica en móvil */
  .mobile-menu[hidden] {
    display: none !important;
  }

  .mobile-menu {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-sm);
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  /* En desktop siempre oculto, independientemente del estado JS */
  @media (min-width: 901px) {
    .mobile-menu {
      display: none !important;
    }
  }

  .mobile-link {
    padding: 12px var(--space-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .mobile-link:hover {
    background-color: var(--color-brand-surface);
    color: var(--color-brand);
  }

  .mobile-cta {
    margin-top: var(--space-xs);
    text-align: center;
  }

  /* ---------------------------------------------------------------
     SECCIONES — LAYOUT BASE
  --------------------------------------------------------------- */
  .section {
    padding-block: var(--space-xl);
  }

  .section-white {
    background-color: var(--color-surface);
  }

  .section-light {
    background-color: var(--color-light);
  }

  .section-brand-surface {
    background-color: var(--color-brand-surface);
  }

  /* ---------------------------------------------------------------
     HERO
  --------------------------------------------------------------- */
  .hero {
    background-color: var(--color-surface);
    padding-block: var(--space-xl) var(--space-2xl);
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-text-primary);
  }

  .text-brand {
    color: var(--color-brand);
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 48ch;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-top: var(--space-xs);
  }

  /* Hero visual (columna derecha) */
  .hero-visual {
    display: flex;
    justify-content: center;
    position: relative;
  }

  /* Mockup de teléfono */
  .phone-mockup {
    width: 260px;
    background: #fff;
    border-radius: 40px;
    box-shadow:
      0 0 0 10px #1c2b1e,
      0 24px 64px rgba(0, 0, 0, 0.3);
    overflow: hidden;
    position: relative;
    z-index: 2;
  }

  .phone-screen {
    background: #f0f4f0;
    min-height: 480px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .phone-statusbar {
    display: flex;
    justify-content: space-between;
    padding: 8px 16px 4px;
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    background: #fff;
  }

  .phone-appbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: #fff;
    border-bottom: 1px solid var(--color-border);
  }

  .phone-appbar-icon {
    font-size: 1rem;
  }

  .phone-appbar-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-brand);
  }

  /* Tarjeta resultado dentro del mockup */
  .result-card {
    margin: 16px 12px;
    background: #fff;
    border-radius: var(--radius-lg);
    padding: 16px;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .result-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 8px;
  }

  .result-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .result-status {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-radius: var(--radius-md);
  }

  .result-status.safe {
    background-color: var(--color-safe-bg);
  }

  .result-icon {
    font-size: 1.25rem;
  }

  .result-level {
    font-size: 0.9375rem;
    font-weight: 800;
    color: var(--color-brand);
    letter-spacing: 0.04em;
  }

  .result-summary {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .result-url {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    background: var(--color-light);
    border-radius: var(--radius-sm);
    border-top: 1px solid var(--color-border);
  }

  .result-url-icon {
    font-size: 0.875rem;
  }

  .result-url-text {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .result-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .result-analysis-status {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-safe);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .result-time {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  /* Glow de fondo hero */
  .hero-glow {
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(76, 175, 80, 0.15) 0%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    pointer-events: none;
  }

  /* Patrón QR de fondo */
  .hero-bg-pattern {
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-bg-pattern svg {
    width: 100%;
    height: 100%;
  }

  /* ---------------------------------------------------------------
     CARDS GRID
  --------------------------------------------------------------- */
  .cards-grid {
    display: grid;
    gap: var(--space-md);
  }

  .cards-grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  /* Card base */
  .card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-border);
    transition: transform var(--transition-normal),
                box-shadow var(--transition-normal);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  /* Icono en cards */
  .card-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background-color: var(--color-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-xs);
    flex-shrink: 0;
  }

  .card-icon-wrap svg {
    width: 24px;
    height: 24px;
    color: var(--color-text-secondary);
  }

  .card-icon-brand {
    background-color: var(--color-brand-surface);
  }

  .card-icon-brand svg {
    color: var(--color-brand);
  }

  .card-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .card-text {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Card problem: icono gris */
  .card-problem .card-icon-wrap svg {
    color: var(--color-text-muted);
  }

  /* ---------------------------------------------------------------
     SECCIÓN QUISHING
  --------------------------------------------------------------- */
  .quishing-block {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-lg);
    border-left: 4px solid var(--color-suspicious);
    box-shadow: var(--shadow-card);
  }

  .quishing-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-xs);
  }

  .quishing-text {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  /* ---------------------------------------------------------------
     DISCLAIMER / NOTAS
  --------------------------------------------------------------- */
  .disclaimer-text {
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    max-width: 60ch;
    margin-inline: auto;
    margin-top: var(--space-lg);
    line-height: 1.6;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid var(--color-border);
  }

  .note-text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top: var(--space-lg);
    padding: var(--space-sm) var(--space-md);
    background: rgba(255, 255, 255, 0.6);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    line-height: 1.6;
  }

  .note-centered {
    text-align: center;
    max-width: 60ch;
    margin-inline: auto;
  }

  /* ---------------------------------------------------------------
     FLUJO "CÓMO FUNCIONA"
  --------------------------------------------------------------- */
  .steps-flow {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  .step {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-xs);
    padding: var(--space-sm);
  }

  .step-number {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-brand-light);
    line-height: 1;
    font-family: var(--font-mono);
    margin-bottom: 4px;
  }

  .step-icon-wrap {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: var(--color-brand-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-xs);
    border: 2px solid var(--color-brand-light);
  }

  .step-icon-wrap svg {
    width: 28px;
    height: 28px;
    color: var(--color-brand);
  }

  .step-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .step-text {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 20ch;
    margin-inline: auto;
  }

  /* Conector entre pasos */
  .step-connector {
    flex-shrink: 0;
    width: 40px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-brand-light), var(--color-brand-light));
    margin-top: 80px; /* alinear con el icono */
    position: relative;
  }

  .step-connector::after {
    content: '';
    position: absolute;
    right: -6px;
    top: -4px;
    border-left: 7px solid var(--color-brand-light);
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
  }

  /* ---------------------------------------------------------------
     RISK CARDS (Niveles de riesgo)
  --------------------------------------------------------------- */
  .risk-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .risk-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-border);
    border-top: 4px solid transparent;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .risk-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .risk-safe    { border-top-color: var(--color-safe); }
  .risk-suspicious { border-top-color: var(--color-suspicious); }
  .risk-dangerous  { border-top-color: var(--color-dangerous); }

  .risk-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-xs);
  }

  .risk-icon {
    font-size: 2rem;
  }

  .risk-badge {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    text-transform: uppercase;
  }

  .badge-safe       { background: var(--color-safe-bg);       color: #2e7d32; }
  .badge-suspicious { background: var(--color-suspicious-bg); color: #e65100; }
  .badge-dangerous  { background: var(--color-dangerous-bg);  color: #b71c1c; }

  .risk-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .risk-text {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* ---------------------------------------------------------------
     CAPTURAS (Screenshots)
  --------------------------------------------------------------- */
  .screenshots-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    align-items: start;
  }

  .screenshot-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  /* Marco de teléfono (para imágenes reales) */
  .phone-frame {
    width: 100%;
    max-width: 180px;
    aspect-ratio: 9 / 19;
    background-color: #1c2b1e;
    border-radius: 28px;
    padding: 6px;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.2),
      inset 0 0 0 1px rgba(255, 255, 255, 0.05);
    position: relative;
    transition: transform var(--transition-normal);
  }

  .phone-frame:hover {
    transform: translateY(-6px);
  }

  /* Acento de color superior según resultado */
  .phone-frame-safe       { box-shadow: 0 8px 32px rgba(76, 175, 80, 0.25), inset 0 0 0 1px rgba(76,175,80,0.2); }
  .phone-frame-suspicious { box-shadow: 0 8px 32px rgba(255, 143, 0, 0.25), inset 0 0 0 1px rgba(255,143,0,0.2); }
  .phone-frame-dangerous  { box-shadow: 0 8px 32px rgba(211, 47, 47, 0.25), inset 0 0 0 1px rgba(211,47,47,0.2); }

  .phone-frame-inner {
    width: 100%;
    height: 100%;
    border-radius: 22px;
    overflow: hidden;
    background: var(--color-light);
  }

  /* Placeholder para cuando no hay imagen */
  .screenshot-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: var(--space-sm);
    text-align: center;
    background: linear-gradient(160deg, #f5f7f5 0%, #e8f5e9 100%);
  }

  .ph-icon {
    font-size: 2rem;
    color: var(--color-text-muted);
  }

  .ph-icon svg {
    width: 36px;
    height: 36px;
  }

  .ph-icon-safe       { color: var(--color-safe);       font-size: 2.5rem; }
  .ph-icon-suspicious { color: var(--color-suspicious); font-size: 2.5rem; }
  .ph-icon-dangerous  { color: var(--color-dangerous);  font-size: 2.5rem; }

  .ph-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    line-height: 1.3;
  }

  .ph-sublabel {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  .screenshot-caption {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-align: center;
  }

  /* ---------------------------------------------------------------
     LISTA DE SEGURIDAD
  --------------------------------------------------------------- */
  .security-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    max-width: 900px;
    margin-inline: auto;
  }

  .security-item {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-border);
    transition: transform var(--transition-normal);
  }

  .security-item:hover {
    transform: translateY(-2px);
  }

  .security-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background-color: var(--color-brand-surface);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .security-icon svg {
    width: 20px;
    height: 20px;
    color: var(--color-brand);
  }

  .security-content {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .security-content strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* ---------------------------------------------------------------
     STACK TÉCNICO
  --------------------------------------------------------------- */
  .tech-groups {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .tech-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .tech-group-title {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 4px;
  }

